<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dynamic Employee Dashboard</title>
    <link rel="stylesheet" href="./styles.css">
</head>
<body>

    <div class="container">

        <div class="employee-form">
            <form id="employeeForm">

                <label for="employeeName">Employee Name</label>
                <input
                    type="text"
                    id="employeeName"
                    placeholder="Employee Name"
                    required
                >

                <label for="employeeRole">Employee Role</label>
                <input
                    type="text"
                    id="employeeRole"
                    placeholder="Employee Role"
                    required
                >

                <button type="submit">Add Employee</button>

            </form>
        </div>

        <div id="employeeContainer"></div>

    </div>

    <script src="./script.js"></script>
</body>
</html>



Styles.css


* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    background-color: #000;
    font-family: Arial, sans-serif;
    min-height: 100vh;
}

.container {
    width: 100%;
    min-height: 100vh;
    padding-top: 32px;
}

.employee-form {
    width: 430px;
    max-width: calc(100% - 30px);
    margin: 0 auto;
    padding: 40px 21px 22px;
    background-color: #b8d8b4;
    border-radius: 6px;
}

.employee-form label {
    display: block;
    margin-bottom: 6px;
    font-family: "Times New Roman", serif;
    font-size: 22px;
    font-weight: bold;
}

.employee-form input {
    display: block;
    width: 100%;
    height: 41px;
    padding: 10px 12px;
    margin-bottom: 22px;
    border: 1px solid #888;
    border-radius: 4px;
    background-color: white;
    font-size: 14px;
    outline: none;
}

.employee-form input:focus {
    border: 2px solid #104735;
}


.employee-form button {
    display: block;
    width: 100%;
    height: 39px;
    border: none;
    border-radius: 5px;
    background-color: #0b4032;
    color: white;
    font-size: 14px;
    cursor: pointer;
}

.employee-form button:hover {
    background-color: #176149;
}

#employeeContainer {
    width: 94%;
    margin: 44px auto 20px;
}
.employee-card {
    width: 100%;
    min-height: 107px;
    padding: 20px 22px;
    margin-bottom: 46px;
    border-radius: 8px;
    background-color: #b8d8b4;
}

.employee-card h2 {
    margin-bottom: 10px;
    font-family: "Times New Roman", serif;
    font-size: 25px;
    font-weight: bold;
    color: #000;
    text-shadow: 3px 3px 5px #777;
    overflow-wrap: anywhere;
}

.employee-card p {
    font-family: "Times New Roman", serif;
    font-size: 20px;
    font-weight: bold;
    color: #000;
    text-shadow: 3px 3px 5px #777;
    overflow-wrap: anywhere;
}





Script.js


const employeeForm = document.getElementById("employeeForm");

const employeeName = document.getElementById("employeeName");
const employeeRole = document.getElementById("employeeRole");

const employeeContainer = document.getElementById("employeeContainer");


employeeForm.addEventListener("submit", function (event) {

    event.preventDefault();

    const name = employeeName.value.trim();
    const role = employeeRole.value.trim();

    if (name === "" || role === "") {
        alert("Please enter both employee name and role.");
        return;
    }

    const card = document.createElement("div");
    card.className = "employee-card";

    const nameHeading = document.createElement("h2");
    nameHeading.textContent = "Employee Name: " + name;

    const roleParagraph = document.createElement("p");
    roleParagraph.textContent = "Employee Role: " + role;

    card.appendChild(nameHeading);
    card.appendChild(roleParagraph);

    employeeContainer.appendChild(card);

    employeeName.value = "";
    employeeRole.value = "";

    employeeName.focus();
});



